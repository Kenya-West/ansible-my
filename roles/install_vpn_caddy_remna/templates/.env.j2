{% set sd = domains_keys.remna_node | rejectattr('domain', 'equalto', domains_keys.main) | map(attribute='domain') | list | default([]) %}
{% if sd | length > 0 %}
SERVICE_DOMAINS='{{ sd | join(", ") }}'
LOG_FILE_NAME={{ ansible_facts['hostname'] }}-remnanode
NODE_PORT={{ remna_node_app_port }}
{# IP-PORT-COMMENT, a bare IP would restrict every published port to the panels. The control port is for the panels only, the other ports are public #}
{% set ufw_allow_from = [] %}
{% for ip in install_vpn_caddy_remna_panel_ips %}
{%   set _ = ufw_allow_from.append(ip ~ '-' ~ remna_node_app_port ~ '-Panel') %}
{% endfor %}
{% if caddy_occupy_HTTPS is not defined or caddy_occupy_HTTPS == false %}
{%   set _ = ufw_allow_from.append('0.0.0.0/0-443-Public') %}
{% endif %}
{% for port in remna_node_external_ports | default([]) %}
{%   set _ = ufw_allow_from.append('0.0.0.0/0-' ~ port ~ '-Public') %}
{% endfor %}
UFW_ALLOW_FROM='{{ ufw_allow_from | join(";") }}'
{% if remna_node_control_port is defined and (remna_node_control_port | default(0)) > 20 %}
EXTERNAL_PORT={{ remna_node_control_port }}
{% endif %}
{% if remna_node_external_ports is defined and (remna_node_external_ports | length) > 0 %}
{% for port in remna_node_external_ports %}
EXTERNAL_{{ loop.index }}_PORT={{ port | string }}
{% endfor %}
{% endif %}
SECRET_KEY='{{ remna_node_ssl_cert_from_panel }}'
{% if remna_node_use_dns01_cloudflare is defined and remna_node_use_dns01_cloudflare == true %}
CLOUDFLARE_API_TOKEN={{ cloudflare_api_token_dns }}
{% endif %}
{% endif %}