{% set o = '{{' %}
{% set c = '}}' %}
{% if 'vpn_server_remnawave' in setup_server_groups %}
# Base domains of the nodes whose host_relations resolve to this panel
# (group_vars/vpn_caddy/domain_generator.yaml builds their domains_keys from them).
vpn_server_remnawave_node_base_domains:
  main: {{ initial_configure_server_base_domain_name }}
  xray: {{ initial_configure_server_node_xray_base_domain_name }}

{% endif %}
domains_keys:
  main: "{{ o }} inventory_hostname {{ c }}.{{ initial_configure_server_base_domain_name }}"
{% for group in setup_server_groups if group in setup_server_service_domains %}
{% for key, label in setup_server_service_domains[group].items() %}
  {{ key }}: {{ label }}.{{ setup_server_service_base_domains[group] }}
{% endfor %}
{% endfor %}
  remna_node: []

{% if initial_configure_server_default_relation_host | default('', true) | length > 0 %}
host_relations:
  default:
    hosts:
      - host: {{ initial_configure_server_default_relation_host }}

{% endif %}
