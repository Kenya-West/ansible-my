# The prometheus user is added by the role from
# prometheus_server_scrape_credentials.vector of the analytics server this
# host relates to (host_relations).
vector_exporter_server_users:
  - name: {{ standard_user }}
    password: "{{ initial_configure_generated_password_analytics_node_vector_standard_user }}"
    hash_scheme: bcrypt

vector_sinks:
  sinks:
    exporter_sink:
      type: prometheus_exporter
      inputs:
        - host_metrics_source
        - internal_metrics_source
      address: "0.0.0.0:9598"

    axiom_sink:
      type: axiom
      inputs:
        - journald_source
        - parse_logs_containers
      compression: zstd
      # You can switch to hard-coded values if you want,
      # otherwise provide the following variables in docker-compose.yml or .env file
      dataset: ${AXIOM_DATASET}
      org_id: ${AXIOM_ORG_ID}
      token: ${AXIOM_TOKEN}

    victorialogs_sink:
      inputs:
        - journald_source # you can change this name in vector.yaml.j2
        - parse_logs_containers # you can change this name in vector.yaml.j2
      type: elasticsearch
      # endpoints and auth are set by the role from domains_keys.victorialogs and
      # victorialogs_server_httpauth_* of the analytics server this host relates to
      mode: bulk
      api_version: v8
      healthcheck:
        enabled: false
      query:
        _msg_field: message
        _time_field: timestamp
        _stream_fields: host,container_name
