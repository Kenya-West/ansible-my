{% set o = '{{' %}
{% set c = '}}' %}
{% if setup_node_remna_node_enabled %}
domains_node:
{% if setup_node_declared_base_domains %}
  base_domains: {{ setup_node_declared_base_domains | to_json }}
{% endif %}
  net_location_index: {{ initial_configure_host_net_location_index }}
  chain_location_index: {{ initial_configure_host_chain_location_index }}
{% else %}
domains_keys:
  main: "{{ o }} inventory_hostname {{ c }}.{{ setup_node_host_base_domains | first }}"
  main_extra:
{% for base in setup_node_host_base_domains[1:] %}
    - "{{ o }} inventory_hostname {{ c }}.{{ base }}"
{% else %}
    []
{% endfor %}
  remna_node: []
{% endif %}

{% if initial_configure_host_default_relation_host | default('', true) | length > 0 %}
host_relations:
  default:
    hosts:
      - host: {{ initial_configure_host_default_relation_host }}

{% endif %}
