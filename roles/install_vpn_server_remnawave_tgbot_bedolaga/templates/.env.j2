{%- set bot = vpn_server_remnawave_tgbot_bedolaga_settings[current_index] -%}
{%- set service_name_and_index = vpn_server_remnawave_tgbot_bedolaga_settings_global.service_name_prefix ~ '-' ~ (current_index | string) -%}

DOMAIN_FOR_CADDY={{ domains_keys.remnawave_tgbot_bedolaga }}
{% if vpn_server_remnawave_tgbot_bedolaga_external_port is defined %}
EXTERNAL_PORT = {{ vpn_server_remnawave_tgbot_bedolaga_external_port }}
{% endif %}
SERVICE_NAME = {{ service_name_and_index }}

BOT_TOKEN={{ bot.bot_token }}
ADMIN_IDS={{ bot.admin_ids | join(',') }}
BOT_RUN_MODE={{ bot.run_mode }}
{% if bot.run_mode == "webhook" %}
WEBHOOK_URL=https://{{ bot.webhook_url }}/{{ path_to_internal_services_predefined_full }}/{{ service_name_and_index }}
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN={{ bot.webhook_secret_token }}
{% endif %}

WEB_API_ENABLED={{ (bot.web_api_enabled | default(false)) | string | lower }}
{% if bot.web_api_enabled == true %}
WEB_API_PORT={{ bot.web_api_port | default(8080) }}
WEB_API_ALLOWED_ORIGINS={{ bot.web_api_allowed_origins | join(',') }}
WEB_API_DEFAULT_TOKEN={{ bot.web_api_default_token | default('') }}
{% endif %}

REMNAWAVE_API_URL=https://{{ bot.remnawave_api_url }}
REMNAWAVE_API_KEY={{ bot.remnawave_api_key }}
{% if bot.remnawave_auth_type is defined %}
REMNAWAVE_AUTH_TYPE={{ bot.remnawave_auth_type }}
{% endif %}
{% if bot.remnawave_caddy_token is defined %}
REMNAWAVE_CADDY_TOKEN={{ bot.remnawave_caddy_token }}
{% endif %}

SALES_MODE={{ bot.sales_mode }}
{% if bot.sales_mode == "tariffs" %}
MULTI_TARIFF_ENABLED={{ bot.multi_tariff_enabled | string | lower }}
MAX_ACTIVE_SUBSCRIPTIONS={{ bot.max_active_subscriptions }}
{% endif %}

TRIAL_DURATION_DAYS={{ bot.trial_duration_days }}
TRIAL_TRAFFIC_LIMIT_GB={{ bot.trial_traffic_limit_gb }}
TRIAL_DEVICE_LIMIT={{ bot.trial_device_limit }}
TRIAL_PAYMENT_ENABLED={{ bot.trial_payment_enabled | string | lower }}
TRIAL_ACTIVATION_PRICE={{ bot.trial_activation_price }}
TRIAL_ADD_REMAINING_DAYS_TO_PAID={{ bot.trial_add_remaining_days_to_paid | string | lower }}

CABINET_ENABLED={{ bot.cabinet_enabled | string | lower }}
{% if bot.cabinet_enabled == true %}
CABINET_JWT_SECRET={{ bot.cabinet_jwt_secret }}
CABINET_ALLOWED_ORIGINS={{ bot.cabinet_allowed_origins | join(',') }}
{% endif %}