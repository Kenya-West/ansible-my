{% if infra_billing_external_port is defined %}
EXTERNAL_PORT = {{ infra_billing_external_port }}
{% endif %}
SERVICE_DOMAIN = {{ domains_keys.infra_billing }}
{% set infra_billing_name = 'infra-billing' %}
SERVICE_NAME = {{ infra_billing_name }}
PORT = 8080

# Expose the Swagger API docs at /api/docs (public when enabled). Default off.
DOCS=true

# AES-256-GCM key for secrets at rest (provider tokens, admin session secret); openssl rand -base64 32
ENCRYPTION_KEY='{{ infra_billing_encryption_key }}'

# Session cookie Secure flag. Unset = follows NODE_ENV (on in production). Set to false ONLY for
# http-only deployments where the transport is protected elsewhere (Tailscale/NetBird overlay);
# passkeys still require a real secure context (https).
# COOKIE_SECURE=false

# host = compose service {{ infra_billing_name }}-db
DATABASE_URL="postgresql://infra:{{ infra_billing_postgres_password }}@{{ infra_billing_name }}-db:5432/infra_billing?schema=public"

# Postgres container only — not read by the app:
POSTGRES_USER=infra
POSTGRES_PASSWORD={{ infra_billing_postgres_password }}
POSTGRES_DB=infra_billing
POSTGRES_HOST_PORT=5432