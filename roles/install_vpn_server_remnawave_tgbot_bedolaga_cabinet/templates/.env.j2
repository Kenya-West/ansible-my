{%- set bot = vpn_server_remnawave_tgbot_bedolaga_cabinet_settings[current_index] -%}

DOMAIN_FOR_CADDY={{ domains_keys.remnawave_tgbot_bedolaga_cabinet }}
{% if vpn_server_remnawave_tgbot_bedolaga_cabinet_external_port is defined %}
EXTERNAL_PORT = {{ vpn_server_remnawave_tgbot_bedolaga_cabinet_external_port }}
{% endif %}
SERVICE_NAME = {{ vpn_server_remnawave_tgbot_bedolaga_cabinet_settings_global.service_name_prefix }}-{{ current_index | string }}

BACKEND_API_HOST={{ bot.backend_api_host }}
BACKEND_API_PATH={{ bot.backend_api_path }}

TELEGRAM_OIDC_ENABLED={{ bot.telegram_oidc_enabled | default(false) | string | lower }}
{% if bot.telegram_oidc_enabled | default(false) %}
TELEGRAM_OIDC_CLIENT_ID={{ bot.telegram_oidc_client_id }}
TELEGRAM_OIDC_CLIENT_SECRET={{ bot.telegram_oidc_client_secret }}
{% endif %}
